# Same-origin API path (recommended for local Sanctum cookie auth via Vite proxy)
VITE_API_BASE_URL=/api/v1

# Laravel origin used by the Vite proxy only
VITE_BACKEND_ORIGIN=http://localhost:8000

# Public participant app origin. Must match backend FRONTEND_URL.
# Used only for the Admin login "Forgot password?" link. Not a secret.
VITE_FRONTEND_URL=http://localhost:5180
